POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
POSTGRES_DB=bookingapi
DATABASE_URL=postgresql+psycopg2://app:app_dev_password@db:5432/bookingapi

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# A weak/guessable value here lets anyone forge valid login tokens — never
# use the literal placeholder below outside a throwaway local sandbox.
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional: from Google Cloud Console > APIs & Services > Credentials.
# See README.md "Google Calendar sync" for setup steps. Leave blank to
# disable the integration (the connect flow returns 503).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Encrypts google_refresh_token at rest. Generate with:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=

# Concurrency-control strategy for create_booking() — see app/booking_lock.py.
# "exclusion_constraint" (default) needs nothing below; the Postgres EXCLUDE
# constraint alone is the guarantee. "redis" additionally serializes attempts
# on the same resource through a Redis lock before falling through to the
# same constraint.
BOOKING_LOCK_STRATEGY=exclusion_constraint
REDIS_URL=redis://redis:6379/0
